    create  table
      "s3"."main"."daily_sales"
  
    
    as (
      with __dbt__cte__delta_dates as (


SELECT CAST(NULL AS DATE) AS order_date WHERE FALSE

) -- depends_on: __dbt__cte__delta_dates

SELECT o.o_orderdate AS order_date, COUNT(DISTINCT l.l_orderkey) AS orders_count, COUNT(*) AS line_count, SUM(l.l_extendedprice * (1 - l.l_discount)) AS gross_revenue, SUM(l.l_extendedprice * (1 - l.l_discount) * (1 + l.l_tax)) AS net_revenue
FROM "s3"."main"."stg_lineitem" l
JOIN "s3"."main"."stg_orders" o ON l.l_orderkey = o.o_orderkey

GROUP BY o.o_orderdate
    );
    
  
  
