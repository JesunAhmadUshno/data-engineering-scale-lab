    create  table
      "build_run3"."main"."ranked_sales"
  
    
    as (
      with __dbt__cte__delta_dates as (


SELECT CAST(NULL AS DATE) AS order_date WHERE FALSE

) -- depends_on: __dbt__cte__delta_dates

SELECT o_orderdate AS order_date, l_orderkey, l_linenumber, l_extendedprice * (1 - l_discount) AS line_amount, RANK() OVER (PARTITION BY o_orderdate ORDER BY l_extendedprice * (1 - l_discount) DESC) AS rnk
FROM "build_run3"."main"."int_lineitem_orders"

    );
    
  
  
